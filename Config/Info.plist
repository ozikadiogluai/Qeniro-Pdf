	<key>NSDocumentsFolderUsageDescription</key>
	<string>Qeniro PDF, Belgeler klasöründeki PDF dosyalarınızı açmak ve kaydetmek için erişim ister.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Qeniro PDF, İndirilenler klasöründeki PDF dosyalarınızı açmak için erişim ister.</string>
