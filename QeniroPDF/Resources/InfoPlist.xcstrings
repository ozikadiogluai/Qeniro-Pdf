    "NSDesktopFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Qeniro PDF إلى الوصول لفتح ملفات PDF وحفظها على سطح المكتب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF needs access to open and save PDF files on your Desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF necesita acceso para abrir y guardar archivos PDF en tu Escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF a besoin d'accéder à votre Bureau pour ouvrir et enregistrer des fichiers PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF richiede l'accesso per aprire e salvare i file PDF sulla Scrivania."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF heeft toegang nodig om pdf-bestanden op je bureaublad te openen en te bewaren."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Qeniro PDF precisa de acesso para abrir e guardar ficheiros PDF na sua Secretária."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF, Masaüstündeki PDF dosyalarınızı açmak ve kaydetmek için erişim ister."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Qeniro PDF إلى الوصول لفتح ملفات PDF وحفظها في مجلد المستندات."
          }
