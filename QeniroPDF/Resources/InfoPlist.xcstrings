        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF necesita acceso para abrir y guardar archivos PDF en tu carpeta Documentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF a besoin d'accéder à votre dossier Documents pour ouvrir et enregistrer des fichiers PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF richiede l'accesso per aprire e salvare i file PDF nella cartella Documenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF heeft toegang nodig om pdf-bestanden in je map Documenten te openen en te bewaren."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Qeniro PDF precisa de acesso para abrir e guardar ficheiros PDF na pasta Documentos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF, Belgeler klasöründeki PDF dosyalarınızı açmak ve kaydetmek için erişim ister."
