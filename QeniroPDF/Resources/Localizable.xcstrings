    "Dosyaları buraya sürükleyin veya \"Dosya Ekle\" ile seçin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب الملفات إلى هنا أو اخترها عبر \"إضافة ملفات\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag files here or choose them with \"Add Files\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra archivos aquí o elígelos con \"Añadir archivos\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des fichiers ici ou choisissez-les avec « Ajouter des fichiers »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina qui i file o sceglili con \"Aggiungi file\"."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep bestanden hierheen of kies ze met \"Bestanden toevoegen\"."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste ficheiros para aqui ou escolha-os com \"Adicionar ficheiros\"."
          }
        }
      }
    },
    "Doğrulama, imzanın kapsadığı baytları ve imzalayan sertifikasını macOS güven ayarlarına göre denetler." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفحص التحقق البايتات التي يغطيها التوقيع وشهادة الموقِّع وفق إعدادات الثقة في macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verification checks the bytes covered by the signature and the signer's certificate against macOS trust settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verificación comprueba los bytes cubiertos por la firma y el certificado del firmante según los ajustes de confianza de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification contrôle les octets couverts par la signature et le certificat du signataire selon les réglages de confiance de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verifica controlla i byte coperti dalla firma e il certificato del firmatario secondo le impostazioni di attendibilità di macOS."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De controle toetst de door de handtekening gedekte bytes en het certificaat van de ondertekenaar aan de vertrouwensinstellingen van macOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação confere os bytes cobertos pela assinatura e o certificado do signatário segundo as definições de confiança do macOS."
          }
        }
      }
    },
