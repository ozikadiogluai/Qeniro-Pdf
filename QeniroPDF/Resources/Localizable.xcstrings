    "Açma şifresi belgeyi açmak için gerekir. İzin şifresi yazdırma/kopyalama kısıtlarını değiştirmeyi korur. Şifreleme: 128 bit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمة مرور الفتح مطلوبة لفتح المستند. تحمي كلمة مرور الأذونات قيود الطباعة/النسخ من التغيير. التشفير: 128 بت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The open password is required to open the document. The permissions password protects changes to print/copy restrictions. Encryption: 128-bit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de apertura es necesaria para abrir el documento. La de permisos protege los cambios en las restricciones de impresión/copia. Cifrado: 128 bits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe d'ouverture est requis pour ouvrir le document. Celui des autorisations protège les restrictions d'impression/copie. Chiffrement : 128 bits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password di apertura serve per aprire il documento. Quella delle autorizzazioni protegge le restrizioni di stampa/copia. Crittografia: 128 bit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het openingswachtwoord is nodig om het document te openen. Het rechtenwachtwoord beschermt de afdruk-/kopieerbeperkingen. Versleuteling: 128 bit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha de abertura é necessária para abrir o documento. A senha de permissões protege alterações às restrições de impressão/cópia. Encriptação: 128 bits."
          }
        }
      }
    },
