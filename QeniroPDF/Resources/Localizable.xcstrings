    "Çıktılar \"_temiz\" ekiyle kaydedilir. Görünen metni kaldırmak için PDF'de Sansürle aracını kullanın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ المخرجات باللاحقة \"_نظيف\". لإزالة النص المرئي استخدم أداة تنقيح PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outputs are saved with a \"_clean\" suffix. To remove visible text, use the Redact PDF tool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados se guardan con el sufijo \"_limpio\". Para eliminar texto visible, usa la herramienta Censurar PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats sont enregistrés avec le suffixe « _nettoyé ». Pour supprimer du texte visible, utilisez l'outil Biffer le PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati vengono salvati con il suffisso \"_pulito\". Per rimuovere il testo visibile, usa lo strumento Oscura PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultaten worden bewaard met het achtervoegsel \"_opgeschoond\". Gebruik de tool Pdf redigeren om zichtbare tekst te verwijderen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados são guardados com o sufixo \"_limpo\". Para remover texto visível, use a ferramenta Censurar PDF."
          }
        }
      }
    },
    "Çıktılar özgün dosyaların yanına \"_sıkıştırılmış\" ekiyle kaydedilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ المخرجات بجوار الملفات الأصلية باللاحقة \"_مضغوط\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outputs are saved next to the original files with a \"_compressed\" suffix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados se guardan junto a los originales con el sufijo \"_comprimido\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats sont enregistrés à côté des originaux avec le suffixe « _compressé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati vengono salvati accanto agli originali con il suffisso \"_compresso\"."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultaten worden naast de originele bestanden bewaard met het achtervoegsel \"_gecomprimeerd\"."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados são guardados junto aos originais com o sufixo \"_comprimido\"."
          }
        }
      }
    },
    "Çıktıların kaydedileceği klasörü seçin" : {
      "localizations" : {
