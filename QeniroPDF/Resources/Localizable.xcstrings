    "Word (.docx/.doc/.rtf/.odt) ve metin dosyaları yerleşik motorla dönüştürülür. Excel, PowerPoint, Pages, Numbers, Keynote için ücretsiz LibreOffice'i kurun." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحوَّل ملفات Word (.docx/.doc/.rtf/.odt) والملفات النصية بالمحرّك المدمج. لملفات Excel وPowerPoint وPages وNumbers وKeynote ثبّت LibreOffice المجاني."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word (.docx/.doc/.rtf/.odt) and text files are converted with the built-in engine. For Excel, PowerPoint, Pages, Numbers and Keynote, install the free LibreOffice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de Word (.docx/.doc/.rtf/.odt) y de texto se convierten con el motor integrado. Para Excel, PowerPoint, Pages, Numbers y Keynote, instala LibreOffice (gratis)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers Word (.docx/.doc/.rtf/.odt) et texte sont convertis avec le moteur intégré. Pour Excel, PowerPoint, Pages, Numbers et Keynote, installez LibreOffice (gratuit)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file Word (.docx/.doc/.rtf/.odt) e di testo vengono convertiti con il motore integrato. Per Excel, PowerPoint, Pages, Numbers e Keynote, installa LibreOffice (gratuito)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word-bestanden (.docx/.doc/.rtf/.odt) en tekstbestanden worden met de ingebouwde engine geconverteerd. Installeer het gratis LibreOffice voor Excel, PowerPoint, Pages, Numbers en Keynote."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros Word (.docx/.doc/.rtf/.odt) e de texto são convertidos com o motor integrado. Para Excel, PowerPoint, Pages, Numbers e Keynote, instale o LibreOffice (gratuito)."
          }
        }
      }
    },
