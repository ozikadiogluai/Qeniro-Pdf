    "Belge \"%@\" sertifikasıyla imzalandı. İmzayı doğrulamak için dosyayı Adobe Acrobat Reader'da açabilirsiniz." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وُقّع المستند بالشهادة \"%@\". للتحقق من التوقيع يمكنك فتح الملف في Adobe Acrobat Reader."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document was signed with the \"%@\" certificate. To verify the signature, you can open the file in Adobe Acrobat Reader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento se firmó con el certificado \"%@\". Para verificar la firma, puedes abrir el archivo en Adobe Acrobat Reader."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document a été signé avec le certificat « %@ ». Pour vérifier la signature, ouvrez le fichier dans Adobe Acrobat Reader."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento è stato firmato con il certificato \"%@\". Per verificare la firma, puoi aprire il file in Adobe Acrobat Reader."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het document is ondertekend met het certificaat \"%@\". Open het bestand in Adobe Acrobat Reader om de handtekening te controleren."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento foi assinado com o certificado \"%@\". Para verificar a assinatura, pode abrir o ficheiro no Adobe Acrobat Reader."
          }
        }
      }
    },
    "Belge değiştirilmemiş, ancak imzalayanın sertifikası doğrulanamadı (güvenilir bir kökten değil, süresi dolmuş veya iptal edilmiş olabilir)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتغيّر المستند، لكن تعذّر التحقق من شهادة الموقِّع (ربما ليست من جذر موثوق، أو انتهت صلاحيتها أو أُلغيت)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document hasn't changed, but the signer's certificate couldn't be verified (it may not come from a trusted root, or it may have expired or been revoked)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento no ha cambiado, pero no se pudo verificar el certificado del firmante (puede que no proceda de una raíz de confianza, o que haya caducado o se haya revocado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document n'a pas changé, mais le certificat du signataire n'a pas pu être vérifié (il ne provient peut-être pas d'une racine approuvée, a expiré ou a été révoqué)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento non è stato modificato, ma non è stato possibile verificare il certificato del firmatario (potrebbe non provenire da una radice attendibile, essere scaduto o revocato)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het document is niet gewijzigd, maar het certificaat van de ondertekenaar kan niet worden gecontroleerd (mogelijk niet van een vertrouwde basis, verlopen of ingetrokken)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento não foi alterado, mas não foi possível verificar o certificado do signatário (pode não vir de uma raiz fidedigna, ter expirado ou ter sido revogado)."
          }
        }
      }
    },
