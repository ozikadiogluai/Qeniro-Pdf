    "Karşı tarafın imzalayacağı boş bir imza alanı ekler. Belgeyi kaydedip paylaşın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف حقل توقيع فارغاً ليوقّع عليه الطرف الآخر. احفظ المستند وشاركه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds an empty signature field for the other party to sign. Save and share the document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un campo de firma vacío para que firme la otra parte. Guarda y comparte el documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un champ de signature vide que l'autre partie pourra signer. Enregistrez et partagez le document."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un campo firma vuoto che l'altra parte potrà firmare. Salva e condividi il documento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een leeg handtekeningveld toe dat de andere partij kan ondertekenen. Bewaar en deel het document."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um campo de assinatura vazio para a outra parte assinar. Guarde e partilhe o documento."
          }
        }
      }
    },
