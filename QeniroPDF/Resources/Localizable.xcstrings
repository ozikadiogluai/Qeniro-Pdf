    "Yıldızlı dosya yok. Bir dosyayı yıldızlamak için görüntüleyicideki yıldız düğmesini veya listedeki ⋮ menüsünü kullanın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد ملفات مميّزة بنجمة. لتمييز ملف، استخدم زر النجمة في العارض أو قائمة ⋮ في القائمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No starred files. To star a file, use the star button in the viewer or the ⋮ menu in the list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay archivos destacados. Para destacar uno, usa el botón de estrella del visor o el menú ⋮ de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fichier favori. Pour ajouter un fichier, utilisez le bouton étoile de la visionneuse ou le menu ⋮ de la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun file nei preferiti. Per aggiungerne uno, usa il pulsante stella nel visore o il menu ⋮ dell'elenco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen bestanden met ster. Gebruik de sterknop in de viewer of het ⋮-menu in de lijst om een ster te geven."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ficheiros com estrela. Para marcar um ficheiro, use o botão de estrela no visualizador ou o menu ⋮ da lista."
