    "Değişiklikler seçili satıra uygulanır. Yazı tipi değişirse satır seçilen sistem yazı tipiyle yeniden yazılır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق التغييرات على السطر المحدد. إذا تغيّر الخط، يُعاد كتابة السطر بخط النظام المختار."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes apply to the selected line. If the font changes, the line is rewritten with the chosen system font."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se aplican a la línea seleccionada. Si cambia la fuente, la línea se reescribe con la fuente del sistema elegida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications s'appliquent à la ligne sélectionnée. Si la police change, la ligne est réécrite avec la police système choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche si applicano alla riga selezionata. Se cambi il font, la riga viene riscritta con il font di sistema scelto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen gelden voor de geselecteerde regel. Als het lettertype verandert, wordt de regel herschreven met het gekozen systeemlettertype."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações aplicam-se à linha selecionada. Se o tipo de letra mudar, a linha é reescrita com o tipo de letra do sistema escolhido."
          }
        }
      }
    },
    "Değiştirilme" : {
      "localizations" : {
