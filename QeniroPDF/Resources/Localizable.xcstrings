    "Yalnızca seçilebilir metni olmayan (taranmış) sayfalar işlenir. Tanıma dili cihazınızın diline göre seçilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعالَج فقط الصفحات التي لا تحتوي على نص قابل للتحديد (الممسوحة). تُختار لغة التعرّف حسب لغة جهازك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only pages without selectable text (scanned) are processed. The recognition language is chosen based on your device language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se procesan las páginas sin texto seleccionable (escaneadas). El idioma de reconocimiento se elige según el idioma de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les pages sans texte sélectionnable (numérisées) sont traitées. La langue de reconnaissance est choisie selon la langue de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono elaborate solo le pagine senza testo selezionabile (scansionate). La lingua di riconoscimento viene scelta in base alla lingua del dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen pagina's zonder selecteerbare tekst (gescand) worden verwerkt. De herkenningstaal wordt gekozen op basis van de taal van je apparaat."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só são processadas as páginas sem texto selecionável (digitalizadas). O idioma de reconhecimento é escolhido segundo o idioma do dispositivo."
          }
        }
      }
    },
    "Yapışkan not eklemek için sayfada bir yere tıklayın." : {
