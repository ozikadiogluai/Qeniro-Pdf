    "Yedek yöntem: özgün metnin üstü beyaz kutuyla örtülür. Gerçek düzenleme için \"Metin\" aracını kullanın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طريقة بديلة: يُغطّى النص الأصلي بمربع أبيض. للتحرير الفعلي استخدم أداة \"نص\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback method: the original text is covered with a white box. For real editing, use the \"Text\" tool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Método alternativo: el texto original se tapa con un cuadro blanco. Para editar de verdad, usa la herramienta \"Texto\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méthode de secours : le texte d'origine est recouvert d'un cadre blanc. Pour une vraie modification, utilisez l'outil « Texte »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metodo alternativo: il testo originale viene coperto con un riquadro bianco. Per una vera modifica, usa lo strumento \"Testo\"."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatieve methode: de oorspronkelijke tekst wordt afgedekt met een wit vak. Gebruik voor echt bewerken de tool \"Tekst\"."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Método alternativo: o texto original é tapado com uma caixa branca. Para editar de verdade, use a ferramenta \"Texto\"."
          }
        }
      }
    },
