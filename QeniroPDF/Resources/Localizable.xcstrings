    "Her PDF sayfası ayrı bir çalışma sayfasına aktarılır; sütunlar metin konumlarından çıkarılır, sayılar sayı olarak yazılır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذهب كل صفحة PDF إلى ورقة عمل منفصلة؛ تُستنتج الأعمدة من مواضع النص وتُكتب الأرقام كأرقام."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each PDF page goes to a separate worksheet; columns are inferred from text positions and numbers are written as numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página del PDF va a una hoja distinta; las columnas se deducen de la posición del texto y los números se escriben como números."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque page du PDF va dans une feuille distincte ; les colonnes sont déduites de la position du texte et les nombres sont écrits comme des nombres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pagina del PDF va in un foglio separato; le colonne vengono dedotte dalla posizione del testo e i numeri scritti come numeri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke pdf-pagina komt op een apart werkblad; kolommen worden afgeleid uit tekstposities en getallen worden als getallen geschreven."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página do PDF vai para uma folha separada; as colunas são deduzidas das posições do texto e os números são escritos como números."
          }
        }
      }
    },
    "Her aralık ayrı bir PDF olur. \"8-\" sekizinci sayfadan sona kadar demektir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح كل نطاق ملف PDF منفصلاً. \"8-\" تعني من الصفحة الثامنة حتى النهاية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each range becomes a separate PDF. \"8-\" means from page eight to the end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada rango se convierte en un PDF. \"8-\" significa desde la página ocho hasta el final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque plage devient un PDF distinct. « 8- » signifie de la page huit jusqu'à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni intervallo diventa un PDF separato. \"8-\" significa dalla pagina otto alla fine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk bereik wordt een aparte pdf. \"8-\" betekent vanaf pagina acht tot het einde."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada intervalo torna-se um PDF separado. \"8-\" significa da página oito até ao fim."
          }
        }
      }
    },
