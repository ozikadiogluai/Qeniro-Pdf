    "Özgün yazı tipi yeni karakterleri içermediği için bu satır benzer bir sistem yazı tipiyle yeniden yazıldı (metin PDF içinde gerçekten değişti)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي الخط الأصلي على الأحرف الجديدة، لذا أُعيدت كتابة هذا السطر بخط نظام مشابه (تغيّر النص فعلاً داخل ملف PDF)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original font doesn't contain the new characters, so this line was rewritten with a similar system font (the text really changed inside the PDF)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente original no contiene los nuevos caracteres, así que esta línea se reescribió con una fuente del sistema similar (el texto cambió de verdad dentro del PDF)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La police d'origine ne contient pas les nouveaux caractères ; cette ligne a donc été réécrite avec une police système similaire (le texte a réellement changé dans le PDF)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il font originale non contiene i nuovi caratteri, quindi questa riga è stata riscritta con un font di sistema simile (il testo è stato davvero modificato nel PDF)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het oorspronkelijke lettertype bevat de nieuwe tekens niet, dus deze regel is herschreven met een vergelijkbaar systeemlettertype (de tekst is echt gewijzigd in de pdf)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tipo de letra original não contém os novos caracteres, por isso esta linha foi reescrita com um tipo de letra do sistema semelhante (o texto mudou realmente no PDF)."
          }
        }
      }
    },
    "Öğeleri sürükleyerek taşıyın, köşelerden boyutlandırın, ⌫ ile silin. Bitirince **Uygula** ile sayfaya kalıcı olarak gömün." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب العناصر لنقلها، وغيّر حجمها من الزوايا، واحذفها بـ ⌫. عند الانتهاء، ادمجها نهائياً عبر **تطبيق**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag items to move them, resize them from the corners and delete with ⌫. When you're done, embed them permanently with **Apply**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los elementos para moverlos, cambia su tamaño desde las esquinas y elimínalos con ⌫. Al terminar, incrústalos de forma permanente con **Aplicar**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les éléments pour les déplacer, redimensionnez-les par les coins et supprimez-les avec ⌫. Une fois terminé, intégrez-les définitivement avec **Appliquer**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina gli elementi per spostarli, ridimensionali dagli angoli ed eliminali con ⌫. Al termine, incorporali in modo permanente con **Applica**."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep items om ze te verplaatsen, wijzig de grootte via de hoeken en verwijder met ⌫. Als je klaar bent, sluit je ze definitief in met **Pas toe**."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os itens para os mover, redimensione-os pelos cantos e apague com ⌫. No fim, incorpore-os permanentemente com **Aplicar**."
          }
        }
      }
    },
