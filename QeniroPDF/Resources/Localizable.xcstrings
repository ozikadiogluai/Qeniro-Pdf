    "Bu PDF sıkıştırılmış çapraz başvuru akışı kullanıyor; sertifika imzası için desteklenmiyor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم ملف PDF هذا دفق مراجع متقاطعة مضغوطاً، وهو غير مدعوم للتوقيع بالشهادة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PDF uses a compressed cross-reference stream, which isn't supported for certificate signing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PDF usa un flujo de referencias cruzadas comprimido, que no se admite para la firma con certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce PDF utilise un flux de références croisées compressé, non pris en charge pour la signature par certificat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PDF usa un flusso di riferimenti incrociati compresso, non supportato per la firma con certificato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pdf gebruikt een gecomprimeerde kruisverwijzingsstroom; dat wordt niet ondersteund bij ondertekenen met een certificaat."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PDF usa um fluxo de referências cruzadas comprimido, que não é suportado na assinatura com certificado."
          }
        }
      }
    },
