    "İmzanın kapsadığı bayt aralığı dosyayla uyuşmuyor; dosya imzadan sonra değiştirilmiş olabilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطاق البايتات الذي يغطيه التوقيع لا يطابق الملف؛ ربما عُدّل الملف بعد التوقيع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The byte range covered by the signature doesn't match the file; the file may have been changed after signing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rango de bytes que cubre la firma no coincide con el archivo; puede que se modificara después de firmarlo."
