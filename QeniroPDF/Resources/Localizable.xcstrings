    "\"%@\" şifreli. Önce Koruma aracıyla şifresini kaldırın veya belgeyi şifresiyle açın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" مشفّر. أزل كلمة المرور أولاً بأداة الحماية، أو افتح المستند بكلمة مروره."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is encrypted. Remove its password with the Protect tool first, or open the document with its password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" está cifrado. Quita primero la contraseña con la herramienta Proteger o abre el documento con su contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est chiffré. Supprimez d'abord son mot de passe avec l'outil Protéger, ou ouvrez le document avec son mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" è crittografato. Rimuovi prima la password con lo strumento Proteggi oppure apri il documento con la sua password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is versleuteld. Verwijder eerst het wachtwoord met de tool Beveiligen of open het document met het wachtwoord."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" está encriptado. Remova primeiro a senha com a ferramenta Proteger ou abra o documento com a senha."
          }
        }
      }
    },
