    "Alan türünü seçin, sonra sayfada bir yere tıklayın. Alanlar doldurulabilir form alanı olarak kaydedilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نوع الحقل، ثم انقر في أي مكان بالصفحة. تُحفظ الحقول كحقول نموذج قابلة للتعبئة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a field type, then click anywhere on the page. Fields are saved as fillable form fields."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un tipo de campo y haz clic en la página. Los campos se guardan como campos de formulario rellenables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un type de champ, puis cliquez sur la page. Les champs sont enregistrés comme champs de formulaire remplissables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un tipo di campo, poi fai clic sulla pagina. I campi vengono salvati come campi modulo compilabili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een veldtype en klik ergens op de pagina. Velden worden bewaard als invulbare formuliervelden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um tipo de campo e clique na página. Os campos são guardados como campos de formulário preenchíveis."
          }
        }
      }
    },
