    "İşaretlenen alanlar uygulandığında kalıcı olarak kaldırılır; yalnızca üstü örtülmez." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التطبيق تُزال المناطق المحددة نهائياً، ولا تُغطّى فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marked areas are permanently removed when applied, not just covered up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aplicar, las áreas marcadas se eliminan de forma permanente; no solo se tapan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones marquées sont définitivement supprimées lors de l'application, pas seulement masquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aree contrassegnate vengono rimosse definitivamente quando applichi, non solo coperte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemarkeerde gebieden worden bij toepassen definitief verwijderd, niet alleen afgedekt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aplicar, as áreas marcadas são removidas de forma permanente, não apenas tapadas."
          }
        }
      }
    },
    "İşaretli sayfalar yüksek çözünürlüklü görüntüye dönüştürülür; işaretli içerik dosyada hiçbir biçimde kalmaz. Kaydetmeyi unutmayın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحوَّل الصفحات المحددة إلى صور عالية الدقة؛ ولا يبقى المحتوى المحدد في الملف بأي شكل. لا تنسَ الحفظ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marked pages are converted to high-resolution images; marked content doesn't remain in the file in any form. Don't forget to save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas marcadas se convierten en imágenes de alta resolución; el contenido marcado no queda en el archivo de ninguna forma. No olvides guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages marquées sont converties en images haute résolution ; le contenu marqué ne subsiste sous aucune forme dans le fichier. N'oubliez pas d'enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine contrassegnate vengono convertite in immagini ad alta risoluzione; il contenuto contrassegnato non resta nel file in alcuna forma. Non dimenticare di salvare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemarkeerde pagina's worden omgezet in afbeeldingen met hoge resolutie; gemarkeerde inhoud blijft in geen enkele vorm in het bestand. Vergeet niet te bewaren."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas marcadas são convertidas em imagens de alta resolução; o conteúdo marcado não fica no ficheiro de forma alguma. Não se esqueça de guardar."
          }
        }
      }
    },
