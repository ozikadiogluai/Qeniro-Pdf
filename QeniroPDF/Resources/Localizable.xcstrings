    "Panoda PDF'e dönüştürülebilecek içerik yok. Bir görsel, metin veya PDF kopyalayın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتوي الحافظة على شيء يمكن تحويله إلى PDF. انسخ صورة أو نصاً أو ملف PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clipboard has nothing that can be turned into a PDF. Copy an image, text or PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El portapapeles no contiene nada que se pueda convertir en PDF. Copia una imagen, un texto o un PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le presse-papiers ne contient rien de convertible en PDF. Copiez une image, du texte ou un PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli appunti non contengono nulla da convertire in PDF. Copia un'immagine, un testo o un PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het klembord bevat niets wat naar pdf kan worden omgezet. Kopieer een afbeelding, tekst of pdf."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A área de transferência não tem conteúdo convertível em PDF. Copie uma imagem, texto ou PDF."
          }
        }
      }
    },
    "Panodaki PDF, görsel veya metin yeni bir PDF'e dönüştürülür. Önce bir şey kopyalayın (⌘C)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحوَّل ملف PDF أو الصورة أو النص في الحافظة إلى ملف PDF جديد. انسخ شيئاً أولاً (⌘C)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PDF, image or text on the clipboard is turned into a new PDF. Copy something first (⌘C)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PDF, la imagen o el texto del portapapeles se convierte en un PDF nuevo. Copia algo primero (⌘C)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PDF, l'image ou le texte du presse-papiers est transformé en nouveau PDF. Copiez d'abord quelque chose (⌘C)."
