    "Not: Kaydedilmemiş değişiklikler doğrulamaya dahil değildir. İmzalı bir belgeyi değiştirip kaydetmek mevcut imzaları geçersiz kılar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: لا تُشمل التغييرات غير المحفوظة في التحقق. تعديل مستند موقّع وحفظه يُبطل توقيعاته الحالية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: Unsaved changes aren't included in verification. Changing and saving a signed document invalidates its existing signatures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: los cambios sin guardar no se incluyen en la verificación. Modificar y guardar un documento firmado invalida sus firmas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : les modifications non enregistrées ne sont pas vérifiées. Modifier et enregistrer un document signé invalide ses signatures existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: le modifiche non salvate non sono incluse nella verifica. Modificare e salvare un documento firmato invalida le firme esistenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: niet-bewaarde wijzigingen worden niet gecontroleerd. Een ondertekend document wijzigen en bewaren maakt de bestaande handtekeningen ongeldig."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: as alterações não guardadas não são incluídas na verificação. Alterar e guardar um documento assinado invalida as assinaturas existentes."
          }
        }
      }
    },
