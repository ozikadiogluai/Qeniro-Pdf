    "Office dönüştürmeleri metni, temel biçimi, tabloları ve görselleri aktarır; karmaşık sayfa düzenleri birebir korunmayabilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقل تحويلات Office النص والتنسيق الأساسي والجداول والصور؛ وقد لا تُحفظ التخطيطات المعقدة بدقة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Office conversions carry over text, basic formatting, tables and images; complex layouts may not be preserved exactly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversiones a Office trasladan el texto, el formato básico, las tablas y las imágenes; los diseños complejos pueden no conservarse con exactitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversions Office reprennent le texte, la mise en forme de base, les tableaux et les images ; les mises en page complexes peuvent ne pas être conservées à l'identique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversioni Office trasferiscono testo, formattazione di base, tabelle e immagini; i layout complessi potrebbero non essere mantenuti esattamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Office-conversies nemen tekst, basisopmaak, tabellen en afbeeldingen over; complexe opmaak blijft mogelijk niet exact behouden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversões para Office transferem texto, formatação básica, tabelas e imagens; esquemas complexos podem não ser preservados com exatidão."
          }
        }
      }
    },
