    "\"%@\" açılamadı. Dosya bozuk olabilir veya PDF değildir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح \"%@\". قد يكون الملف تالفاً أو ليس PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't open \"%@\". The file may be damaged or not a PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir \"%@\". Puede que el archivo esté dañado o no sea un PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'ouvrir « %@ ». Le fichier est peut-être endommagé ou n'est pas un PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire \"%@\". Il file potrebbe essere danneggiato o non essere un PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan \"%@\" niet openen. Het bestand is mogelijk beschadigd of geen pdf."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir \"%@\". O ficheiro pode estar danificado ou não ser um PDF."
          }
        }
      }
    },
    "\"%@\" belgesindeki değişiklikler kaydedilsin mi?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حفظ التغييرات في \"%@\"؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save changes to \"%@\"?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Guardar los cambios en \"%@\"?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer les modifications de « %@ » ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvare le modifiche a \"%@\"?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen in \"%@\" bewaren?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar as alterações em \"%@\"?"
          }
        }
      }
    },
    "\"%@\" bir PDF dosyası değil. Başka türdeki dosyaları PDF Oluştur aracıyla dönüştürebilirsiniz." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ليس ملف PDF. يمكنك تحويل أنواع الملفات الأخرى باستخدام أداة إنشاء PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is not a PDF file. You can convert other file types with the Create PDF tool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" no es un archivo PDF. Puedes convertir otros tipos de archivo con la herramienta Crear PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'est pas un fichier PDF. Vous pouvez convertir d'autres types de fichiers avec l'outil Créer un PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" non è un file PDF. Puoi convertire altri tipi di file con lo strumento Crea PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is geen pdf-bestand. Andere bestandstypen kun je omzetten met de tool Pdf maken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" não é um ficheiro PDF. Pode converter outros tipos de ficheiro com a ferramenta Criar PDF."
          }
        }
      }
    },
    "\"%@\" desteklenmeyen bir dosya türü." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" نوع ملف غير مدعوم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is an unsupported file type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" es un tipo de archivo no compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est un type de fichier non pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" è un tipo di file non supportato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is een niet-ondersteund bestandstype."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" é um tipo de ficheiro não suportado."
          }
        }
      }
    },
    "\"%@\" için LibreOffice gerekir (ücretsiz: libreoffice.org). Alternatif: dosyayı kendi uygulamasında açıp Dosya > PDF Olarak Dışa Aktar'ı kullanın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب \"%@\" برنامج LibreOffice (مجاني: libreoffice.org). بدلاً من ذلك، افتح الملف في تطبيقه واستخدم ملف > تصدير بتنسيق PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" requires LibreOffice (free: libreoffice.org). Alternatively, open the file in its own app and use File > Export as PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" requiere LibreOffice (gratis: libreoffice.org). Otra opción: abre el archivo en su app y usa Archivo > Exportar como PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » nécessite LibreOffice (gratuit : libreoffice.org). Sinon, ouvrez le fichier dans son app et utilisez Fichier > Exporter au format PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" richiede LibreOffice (gratuito: libreoffice.org). In alternativa, apri il file nella sua app e usa File > Esporta come PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor \"%@\" is LibreOffice nodig (gratis: libreoffice.org). Of open het bestand in de eigen app en kies Archief > Exporteer als pdf."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" requer o LibreOffice (gratuito: libreoffice.org). Em alternativa, abra o ficheiro na respetiva app e use Ficheiro > Exportar como PDF."
          }
        }
      }
    },
    "\"%@\" kaydedilemedi. Klasöre yazma izniniz olduğundan emin olun." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ \"%@\". تأكّد من أن لديك إذن الكتابة في المجلد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save \"%@\". Make sure you have permission to write to the folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar \"%@\". Asegúrate de tener permiso de escritura en la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer « %@ ». Vérifiez que vous avez l'autorisation d'écrire dans le dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare \"%@\". Assicurati di avere il permesso di scrittura nella cartella."
          }
        },
        "nl" : {
          "stringUnit" : {
