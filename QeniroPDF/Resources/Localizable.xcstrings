    "Önce imza, metin, onay kutusu veya tarih ekleyin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أولاً توقيعاً أو نصاً أو مربع اختيار أو تاريخاً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a signature, text, checkbox or date first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade primero una firma, texto, casilla o fecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d'abord une signature, du texte, une case à cocher ou une date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi prima una firma, un testo, una casella o una data."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg eerst een handtekening, tekst, selectievakje of datum toe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione primeiro uma assinatura, texto, caixa de verificação ou data."
          }
        }
      }
    },
    "Önce kaldırılacak alanları sürükleyerek işaretleyin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب أولاً لتحديد المناطق المراد إزالتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First drag to mark the areas to remove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero arrastra para marcar las áreas que quieres eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites d'abord glisser pour marquer les zones à supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima trascina per contrassegnare le aree da rimuovere."
