    "iCloud Drive'ı Sistem Ayarları > Apple Hesabı > iCloud bölümünden açabilirsiniz. Google Drive, Dropbox ve OneDrive masaüstü uygulamaları da ~/Library/CloudStorage altında görünür." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تشغيل iCloud Drive من إعدادات النظام > حساب Apple > iCloud. تظهر أيضاً تطبيقات Google Drive وDropbox وOneDrive لسطح المكتب ضمن ~/Library/CloudStorage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn on iCloud Drive in System Settings > Apple Account > iCloud. Google Drive, Dropbox and OneDrive desktop apps also appear under ~/Library/CloudStorage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes activar iCloud Drive en Ajustes del Sistema > Cuenta de Apple > iCloud. Las apps de escritorio de Google Drive, Dropbox y OneDrive también aparecen en ~/Library/CloudStorage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez activer iCloud Drive dans Réglages Système > Compte Apple > iCloud. Les apps de bureau Google Drive, Dropbox et OneDrive apparaissent aussi sous ~/Library/CloudStorage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi attivare iCloud Drive in Impostazioni di Sistema > Account Apple > iCloud. Anche le app desktop di Google Drive, Dropbox e OneDrive compaiono in ~/Library/CloudStorage."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt iCloud Drive inschakelen via Systeeminstellingen > Apple Account > iCloud. Desktopapps van Google Drive, Dropbox en OneDrive verschijnen ook onder ~/Library/CloudStorage."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ativar o iCloud Drive em Definições do Sistema > Conta Apple > iCloud. As apps de computador do Google Drive, Dropbox e OneDrive também aparecem em ~/Library/CloudStorage."
          }
        }
      }
    },
