    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Qeniro PDF الكاميرا لمسح المستندات الورقية وتحويلها إلى ملفات PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF uses your camera to scan paper documents and turn them into PDFs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF usa la cámara para escanear documentos en papel y convertirlos en PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF utilise l'appareil photo pour numériser des documents papier et les convertir en PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF usa la fotocamera per scansionare documenti cartacei e trasformarli in PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF gebruikt je camera om papieren documenten te scannen en naar pdf om te zetten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Qeniro PDF usa a câmara para digitalizar documentos em papel e convertê-los em PDF."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF, kâğıt belgeleri tarayıp PDF'ye çevirmek için kameranızı kullanır."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Qeniro PDF إلى إذن لحفظ الصور التي تحوّلها من ملفات PDF في تطبيق الصور."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF needs permission to save images you convert from PDFs to Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF necesita permiso para guardar en Fotos las imágenes que conviertes desde PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF a besoin de votre autorisation pour enregistrer dans Photos les images converties depuis des PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF richiede il permesso di salvare in Foto le immagini convertite dai PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF heeft toestemming nodig om afbeeldingen die je uit pdf's omzet in Foto's te bewaren."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Qeniro PDF precisa de permissão para guardar nas Fotografias as imagens que converte a partir de PDF."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeniro PDF, PDF'den dönüştürdüğünüz görüntüleri Fotoğraflar'a kaydetmek için izin ister."
          }
        }
      }
    },
