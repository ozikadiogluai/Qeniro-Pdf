    "Yerleştirdiğiniz öğeleri sürükleyerek taşıyın. Bitince Uygula ile sayfaya kalıcı olarak gömün." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب العناصر الموضوعة لنقلها. عند الانتهاء، ادمجها نهائياً عبر تطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag placed items to move them. When you're done, embed them permanently with Apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los elementos colocados para moverlos. Al terminar, incrústalos de forma permanente con Aplicar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les éléments placés pour les déplacer. Une fois terminé, intégrez-les définitivement avec Appliquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina gli elementi posizionati per spostarli. Al termine, incorporali in modo permanente con Applica."
