    "Office dönüştürmeleri metni, temel biçimleri ve tabloları aktarır; sayfa düzeni birebir olmayabilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقل تحويلات Office النص والتنسيق الأساسي والجداول؛ وقد لا يكون تخطيط الصفحة مطابقاً تماماً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Office conversions carry over text, basic formatting and tables; the page layout may not be exact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversiones a Office trasladan el texto, el formato básico y las tablas; el diseño de página puede no ser exacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversions Office reprennent le texte, la mise en forme de base et les tableaux ; la mise en page peut ne pas être identique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversioni Office trasferiscono testo, formattazione di base e tabelle; il layout della pagina potrebbe non essere identico."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Office-conversies nemen tekst, basisopmaak en tabellen over; de pagina-opmaak is mogelijk niet exact."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversões para Office transferem texto, formatação básica e tabelas; o esquema da página pode não ser exato."
          }
        }
      }
    },
