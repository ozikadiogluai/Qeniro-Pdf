    "Gerçek metin düzenleme motoru (PDFium) bu derlemede yok. Mac'te build-ios.sh ile yeniden derleyin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرّك تحرير النص الحقيقي (PDFium) غير مضمّن في هذا الإصدار. أعد البناء على جهاز Mac باستخدام build-ios.sh."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The real text editing engine (PDFium) isn't included in this build. Rebuild on your Mac with build-ios.sh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor de edición de texto real (PDFium) no está incluido en esta compilación. Vuelve a compilar en tu Mac con build-ios.sh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vrai moteur d'édition de texte (PDFium) n'est pas inclus dans cette version. Recompilez sur votre Mac avec build-ios.sh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vero motore di modifica del testo (PDFium) non è incluso in questa build. Ricompila sul Mac con build-ios.sh."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De echte tekstbewerkingsengine (PDFium) zit niet in deze build. Bouw opnieuw op je Mac met build-ios.sh."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor de edição de texto real (PDFium) não está incluído nesta compilação. Volte a compilar no Mac com build-ios.sh."
          }
        }
      }
    },
    "Gerçek metin düzenleme motoru (PDFium) bu derlemede yok. Mac'te iOS klasöründeki build-ios.sh betiğini internet bağlantısıyla bir kez çalıştırın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرّك تحرير النص الحقيقي (PDFium) غير مضمّن في هذا الإصدار. على جهاز Mac، شغّل البرنامج النصي build-ios.sh في مجلد iOS مرة واحدة مع اتصال بالإنترنت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The real text editing engine (PDFium) isn't included in this build. On your Mac, run the build-ios.sh script in the iOS folder once with an internet connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor de edición de texto real (PDFium) no está incluido en esta compilación. En tu Mac, ejecuta una vez el script build-ios.sh de la carpeta iOS con conexión a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vrai moteur d'édition de texte (PDFium) n'est pas inclus dans cette version. Sur votre Mac, exécutez une fois le script build-ios.sh du dossier iOS avec une connexion internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vero motore di modifica del testo (PDFium) non è incluso in questa build. Sul Mac, esegui una volta lo script build-ios.sh della cartella iOS con una connessione a internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De echte tekstbewerkingsengine (PDFium) zit niet in deze build. Voer op je Mac één keer het script build-ios.sh in de iOS-map uit met een internetverbinding."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor de edição de texto real (PDFium) não está incluído nesta compilação. No Mac, execute uma vez o script build-ios.sh da pasta iOS com ligação à internet."
          }
        }
      }
