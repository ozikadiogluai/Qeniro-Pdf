    },
    "\"%@\" şifreli. Önce şifresini girerek açın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" مشفّر. افتحه بإدخال كلمة مروره أولاً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is encrypted. Open it by entering its password first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" está cifrado. Ábrelo introduciendo primero su contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est chiffré. Ouvrez-le d'abord en saisissant son mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" è crittografato. Aprilo inserendo prima la password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is versleuteld. Open het eerst met het wachtwoord."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" está encriptado. Abra-o introduzindo primeiro a senha."
          }
        }
