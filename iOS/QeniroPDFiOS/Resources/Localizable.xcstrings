    "\"%@\" açılamadı. Dosya bozuk olabilir veya PDF değildir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح \"%@\". قد يكون الملف تالفاً أو ليس PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't open \"%@\". The file may be damaged or not a PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir \"%@\". Puede que el archivo esté dañado o no sea un PDF."
