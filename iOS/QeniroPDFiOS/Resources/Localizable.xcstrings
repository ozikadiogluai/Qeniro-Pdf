    "Uygulanan imza, metin, onay ve tarih öğeleri artık taşınamaz; belgenin parçası olur." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن بعد ذلك نقل التوقيعات والنصوص وعلامات الاختيار والتواريخ المطبّقة؛ إذ تصبح جزءاً من المستند."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applied signatures, text, checks and dates can no longer be moved; they become part of the document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las firmas, textos, marcas y fechas aplicados ya no se pueden mover; pasan a formar parte del documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signatures, textes, coches et dates appliqués ne peuvent plus être déplacés ; ils font partie du document."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firme, testi, segni di spunta e date applicati non possono più essere spostati: diventano parte del documento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegepaste handtekeningen, tekst, vinkjes en datums kunnen niet meer worden verplaatst; ze worden deel van het document."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas, textos, vistos e datas aplicados já não podem ser movidos; passam a fazer parte do documento."
          }
        }
      }
    },
    "Uygun yazı tipi yüklenemedi." : {
