    "Bu cihazda belge tarayıcı kullanılamıyor (simülatörde kamera yoktur)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسح المستندات غير متاح على هذا الجهاز (لا توجد كاميرا في المحاكي)."
          }
        },
        "en" : {
          "stringUnit" : {
