    "Dosya 128 bit AES ile şifrelendi. Şifreyi unutmayın; kurtarılamaz." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شُفّر الملف بتقنية AES بطول 128 بت. لا تنسَ كلمة المرور؛ لا يمكن استعادتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file was encrypted with 128-bit AES. Don't forget the password; it can't be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se cifró con AES de 128 bits. No olvides la contraseña; no se puede recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a été chiffré en AES 128 bits. N'oubliez pas le mot de passe : il est irrécupérable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file è stato crittografato con AES a 128 bit. Non dimenticare la password: non può essere recuperata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand is versleuteld met 128-bit AES. Vergeet het wachtwoord niet; het kan niet worden hersteld."
