    "{n} sayfa numarası, {N} toplam sayfa, {tarih} bugünün tarihi olur. Metin PDF'e gerçek metin olarak eklenir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} رقم الصفحة، و{N} إجمالي الصفحات، و{date} تاريخ اليوم. يُضاف النص إلى PDF كنص حقيقي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} becomes the page number, {N} the total pages and {date} today's date. The text is added to the PDF as real text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} es el número de página, {N} el total de páginas y {date} la fecha de hoy. El texto se añade al PDF como texto real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} devient le numéro de page, {N} le nombre total de pages et {date} la date du jour. Le texte est ajouté au PDF comme vrai texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} diventa il numero di pagina, {N} il totale delle pagine e {date} la data odierna. Il testo viene aggiunto al PDF come vero testo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} wordt het paginanummer, {N} het totaal aantal pagina's en {date} de datum van vandaag. De tekst wordt als echte tekst aan de pdf toegevoegd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} é o número da página, {N} o total de páginas e {date} a data de hoje. O texto é adicionado ao PDF como texto real."
          }
        }
      }
    },
